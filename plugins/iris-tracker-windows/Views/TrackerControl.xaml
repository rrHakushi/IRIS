<UserControl x:Class="IrisTracker.Views.TrackerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="980">
    <Grid Background="#0F0D11">
        <Grid.RowDefinitions>
            <!-- Top Header Navbar -->
            <RowDefinition Height="Auto" />
            <!-- Offline Banner -->
            <RowDefinition Height="Auto" />
            <!-- Main Content Area -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header Navigation Bar -->
        <Border Grid.Row="0"
                Background="#161419"
                BorderBrush="{StaticResource BorderDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand / Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28"
                            CornerRadius="14"
                            ClipToBounds="True"
                            Background="#221C26"
                            Margin="0,0,10,0">
                        <Image Source="pack://application:,,,/Assets/iris.png" Stretch="UniformToFill" />
                    </Border>

                    <TextBlock Text="Iris"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{StaticResource RosePrimaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="extra"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="5,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- User Info & Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- User Chip -->
                    <Border Background="#1F1B24"
                            BorderBrush="{StaticResource BorderDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Height="32"
                            Padding="12,0"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource RosePrimaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtUsername"
                                       Text="User"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Add Button -->
                    <Button x:Name="BtnLinkGame"
                            Content="Add"
                            Style="{StaticResource PrimaryButton}"
                            Height="32"
                            Padding="16,0"
                            Margin="0,0,8,0"
                            Click="BtnLinkGame_Click" />

                    <!-- Settings Button -->
                    <Button x:Name="BtnSettings"
                            Content="Settings"
                            Style="{StaticResource SecondaryButton}"
                            Height="32"
                            Padding="10,0"
                            Margin="0,0,8,0"
                            Click="BtnSettings_Click" />

                    <!-- Logout Button -->
                    <Button x:Name="BtnLogout"
                            Content="Log Out"
                            Style="{StaticResource SecondaryButton}"
                            Height="32"
                            Padding="10,0"
                            Click="BtnLogout_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status / Offline Banner -->
        <Border x:Name="BannerOffline"
                Grid.Row="1"
                Background="#2B1A0A"
                BorderBrush="#603813"
                BorderThickness="0,0,0,1"
                Padding="16,8"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtOfflineStatus"
                           Text="Offline pending increments queued. Will sync automatically when connected."
                           Foreground="{StaticResource AmberBrush}"
                           FontSize="12"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Content="Retry Sync"
                        Style="{StaticResource SecondaryButton}"
                        Padding="10,3"
                        Click="BtnSyncAll_Click" />
            </Grid>
        </Border>

        <!-- Main Body: Games List or Empty State -->
        <Grid Grid.Row="2" Margin="24,20,24,10">
            <!-- Empty State Card -->
            <Border x:Name="CardEmptyState"
                    Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource BorderDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    MaxWidth="480"
                    MaxHeight="260"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="32"
                    Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="🎮"
                               FontSize="36"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12" />
                    <TextBlock Text="No Linked Games Yet"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Link a Windows executable to an IRIS game list entry to start tracking your playtime automatically."
                               FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,8,0,20" />
                    <Button Content="+ Link Your First Game"
                            Style="{StaticResource PrimaryButton}"
                            Height="36"
                            Padding="16,0"
                            HorizontalAlignment="Center"
                            Click="BtnLinkGame_Click" />
                </StackPanel>
            </Border>

            <!-- Games Section (Matches Screenshot 1) -->
            <ScrollViewer x:Name="ScrollGamesList"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Collapsible Section Header (Matches Screenshot 1) -->
                    <Border BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="0,0,0,12"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: Icon + Games + Count Pill -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Gamepad Icon -->
                                <Path Data="M4,7 C4,5.895 4.895,5 6,5 L18,5 C19.105,5 20,5.895 20,7 L20,13 C20,16.5 17,19 15.5,19 C14.5,19 13.5,18 13,17 L11,17 C10.5,18 9.5,19 8.5,19 C7,19 4,16.5 4,13 Z M8,8 L8,12 M6,10 L10,10 M15.5,9.5 A0.5,0.5 0 1 0 15.5,10.5 A0.5,0.5 0 1 0 15.5,9.5 M17,11.5 A0.5,0.5 0 1 0 17,12.5 A0.5,0.5 0 1 0 17,11.5"
                                      Stroke="{StaticResource TextPrimaryBrush}"
                                      StrokeThickness="1.5"
                                      Fill="Transparent"
                                      Width="18" Height="18"
                                      Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0" />

                                <TextBlock Text="Games"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#FFFFFF"
                                           VerticalAlignment="Center" />

                                <!-- Count Badge Pill -->
                                <Border Background="#231F27"
                                        CornerRadius="10"
                                        Padding="7,2"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtGamesCountBadge"
                                               Text="0"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                </Border>
                            </StackPanel>

                            <!-- Right: Collapse / Expand Chevron -->
                            <Button x:Name="BtnToggleSection"
                                    Grid.Column="2"
                                    Style="{StaticResource SubtleButton}"
                                    Width="28" Height="28"
                                    Padding="0"
                                    Click="BtnToggleSection_Click"
                                    ToolTip="Collapse/Expand section">
                                <TextBlock x:Name="TxtChevronIcon"
                                           Text="⌵"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Games Cards Container (WrapPanel matching Screenshot 1) -->
                    <ItemsControl x:Name="ItemsGamesList" Visibility="Visible">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Single Game Card (Screenshot 1 design) -->
                                <Border Width="162"
                                        Margin="0,0,16,18"
                                        Background="#17151B"
                                        BorderBrush="{StaticResource BorderDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Cursor="Hand"
                                        MouseLeftButtonUp="GameCard_Click"
                                        Tag="{Binding}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="BorderBrush" Value="#4B4455" />
                                                    <Setter Property="Background" Value="#1D1A23" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <!-- Vertical Poster (2:3 aspect) -->
                                            <RowDefinition Height="220" />
                                            <!-- Card Title & Status -->
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Poster Container with Overlays -->
                                        <Border Grid.Row="0"
                                                CornerRadius="11,11,0,0"
                                                ClipToBounds="True"
                                                Background="#1E1B22">
                                            <Grid>
                                                <!-- Cover Image -->
                                                <Image Source="{Binding CoverImage}"
                                                       Stretch="UniformToFill"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />

                                                <!-- Dark bottom gradient for legible badges -->
                                                <Border VerticalAlignment="Bottom" Height="80">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#00000000" Offset="0" />
                                                            <GradientStop Color="#CC09080A" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>

                                                <!-- Top Right: Pause / Resume Button -->
                                                <Button Style="{StaticResource SubtleButton}"
                                                        Width="28" Height="28"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Margin="6"
                                                        Background="#CC16141A"
                                                        BorderBrush="{StaticResource BorderSubtleBrush}"
                                                        BorderThickness="1"
                                                        ToolTip="{Binding PauseResumeButtonText, StringFormat='{}{0} tracking'}"
                                                        Click="BtnCardPauseToggle_Click"
                                                        Tag="{Binding}">
                                                    <TextBlock Text="{Binding PauseResumeIcon}"
                                                               FontSize="10"
                                                               FontWeight="Bold"
                                                               Foreground="{Binding StatusColor}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Button>

                                                <!-- Bottom Left: Hours & Score Badges (Screenshot 1) -->
                                                <StackPanel VerticalAlignment="Bottom"
                                                            HorizontalAlignment="Left"
                                                            Margin="8,0,0,10">
                                                    <!-- Hours Badge (e.g. "18531 Hrs") -->
                                                    <Border Background="#CC000000"
                                                            CornerRadius="4"
                                                            Padding="5,2"
                                                            Margin="0,0,0,4"
                                                            HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding HoursBadgeText}"
                                                                   FontSize="10"
                                                                   FontWeight="Bold"
                                                                   FontFamily="Consolas, Cascadia Code, monospace"
                                                                   Foreground="#FFFFFF" />
                                                    </Border>

                                                    <!-- Score Badge (e.g. "★ 10/10") -->
                                                    <Border Background="#CC000000"
                                                            CornerRadius="4"
                                                            Padding="5,2"
                                                            HorizontalAlignment="Left"
                                                            Visibility="{Binding HasScore, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                                                        <TextBlock Text="{Binding ScoreBadgeText}"
                                                                   FontSize="10"
                                                                   FontWeight="Bold"
                                                                   Foreground="#FBBF24" />
                                                    </Border>
                                                </StackPanel>

                                                <!-- Bottom Right: On-Hover Current Time Badge -->
                                                <Border x:Name="HoverTimeBadge"
                                                        VerticalAlignment="Bottom"
                                                        HorizontalAlignment="Right"
                                                        Margin="0,0,8,10"
                                                        Background="#E60A090D"
                                                        BorderBrush="{StaticResource BorderSubtleBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="6,2"
                                                        IsHitTestVisible="False">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Opacity" Value="0" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Border, AncestorLevel=1}, Path=IsMouseOver}" Value="True">
                                                                    <Setter Property="Opacity" Value="1" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="⏱ "
                                                                   FontSize="9"
                                                                   Foreground="{StaticResource RosePrimaryBrush}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding CurrentTimeProgressText}"
                                                                   FontSize="10"
                                                                   FontWeight="Bold"
                                                                   FontFamily="Consolas, Cascadia Code, monospace"
                                                                   Foreground="#FFFFFF"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- Progress Bar at bottom of poster image -->
                                                <Grid VerticalAlignment="Bottom"
                                                      Height="14"
                                                      Background="Transparent"
                                                      ToolTip="{Binding CurrentTimeHoverTooltip}">
                                                    <ProgressBar Style="{StaticResource CardBottomProgressBar}"
                                                                 VerticalAlignment="Bottom"
                                                                 Height="3"
                                                                 Minimum="0" Maximum="3600"
                                                                 Value="{Binding AccumulatedSeconds}" />
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <!-- Card Footer: Title & Status Dot -->
                                        <Grid Grid.Row="1" Margin="8,8,8,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Game Title -->
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding GameTitle}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxHeight="34"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center" />

                                            <!-- Live Running Dot -->
                                            <Ellipse Grid.Column="1"
                                                     Width="6" Height="6"
                                                     Fill="{Binding RunningStatusDotColor}"
                                                     Margin="6,0,0,0"
                                                     VerticalAlignment="Center"
                                                     ToolTip="{Binding StatusBadgeText}" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
