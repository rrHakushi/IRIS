<Window x:Class="IrisTracker.Views.ManageExecutablesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Manage Linked Executables"
        Height="540" Width="600"
        MinHeight="480" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BgCanvasBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="TxtGameTitle"
                       Text="Game Executables"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="Link multiple executables (e.g. 32/64-bit binaries or launchers). If multiple are running at the same time, playtime is tracked only once."
                       FontSize="12"
                       Foreground="{StaticResource TextMutedBrush}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0" />
        </StackPanel>

        <!-- Current Executables List -->
        <Border Grid.Row="1"
                Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="LINKED EXECUTABLES"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{StaticResource RosePrimaryBrush}"
                           Margin="0,0,0,10" />

                <ListBox x:Name="ListExecutables"
                         Grid.Row="1"
                         Background="#141316"
                         BorderBrush="{StaticResource BorderSubtleBrush}"
                         BorderThickness="1">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,8" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding}"
                                               FontSize="13"
                                               FontFamily="Consolas, Cascadia Code, monospace"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Content="✕ Remove"
                                        Style="{StaticResource DangerButton}"
                                        FontSize="11"
                                        Padding="8,3"
                                        Click="BtnRemoveExe_Click"
                                        Tag="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="TxtNoExes"
                           Grid.Row="1"
                           Text="No executables currently linked."
                           FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed" />
            </Grid>
        </Border>

        <!-- Add Executable Section -->
        <Border Grid.Row="2"
                Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="ADD ANOTHER EXECUTABLE"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="{StaticResource RosePrimaryBrush}"
                           Margin="0,0,0,10" />

                <!-- Running Windows Picker -->
                <TextBlock Text="Pick from active windows"
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}"
                           Margin="0,0,0,4" />
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="CmbRunningWindows"
                              Grid.Column="0"
                              Height="32"
                              DisplayMemberPath="DisplayText" />
                    <Button x:Name="BtnAddFromRunning"
                            Grid.Column="1"
                            Content="+ Add Selected"
                            Style="{StaticResource SecondaryButton}"
                            Margin="8,0,0,0"
                            Padding="10,0"
                            Click="BtnAddFromRunning_Click" />
                </Grid>

                <!-- Manual Input / Browse -->
                <TextBlock Text="Or enter executable name / browse file"
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}"
                           Margin="0,0,0,4" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtNewExe"
                             Grid.Column="0"
                             Height="32" />
                    <Button x:Name="BtnBrowse"
                            Grid.Column="1"
                            Content="Browse..."
                            Style="{StaticResource SecondaryButton}"
                            Margin="8,0,0,0"
                            Padding="10,0"
                            Click="BtnBrowse_Click" />
                    <Button x:Name="BtnAddManual"
                            Grid.Column="2"
                            Content="+ Add"
                            Style="{StaticResource PrimaryButton}"
                            Margin="8,0,0,0"
                            Padding="12,0"
                            Click="BtnAddManual_Click" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button x:Name="BtnClose"
                    Content="Done"
                    Style="{StaticResource PrimaryButton}"
                    Width="100"
                    Height="34"
                    Click="BtnClose_Click" />
        </StackPanel>
    </Grid>
</Window>
