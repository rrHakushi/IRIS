<Window x:Class="IrisTracker.Views.LinkGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Add Game"
        Height="540" Width="600"
        MinHeight="480" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BgCanvasBrush}">
    <Window.Resources>
        <!-- Uppercase Section Label -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </Window.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto" />
            <!-- Pill Tabs -->
            <RowDefinition Height="Auto" />
            <!-- Main Content Area -->
            <RowDefinition Height="*" />
            <!-- Footer Actions -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Add Game"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       VerticalAlignment="Center" />
        </Grid>

        <!-- Pill Navigation Bar -->
        <Border Grid.Row="1"
                Margin="0,0,0,16"
                HorizontalAlignment="Left">
            <Border Background="#18161D"
                    BorderBrush="{StaticResource BorderDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="3">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="TabSelectGame"
                                 Content="Select Game"
                                 Style="{StaticResource TabRadioStyle}"
                                 IsChecked="True"
                                 Checked="Tab_Checked" />
                    <RadioButton x:Name="TabProcess"
                                 Content="Executable / Process"
                                 Style="{StaticResource TabRadioStyle}"
                                 Checked="Tab_Checked" />
                </StackPanel>
            </Border>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Row="2">
            <!-- TAB 1: SELECT GAME -->
            <Grid x:Name="ViewSelectGame" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Search Box -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <TextBox x:Name="TxtSearchGame"
                             Height="34"
                             TextChanged="TxtSearchGame_TextChanged" />
                    <TextBlock x:Name="TxtSearchPlaceholder"
                               Text="Search your game list..."
                               FontSize="12"
                               Foreground="{StaticResource TextDimBrush}"
                               IsHitTestVisible="False"
                               Margin="12,9,0,0" />
                </Grid>

                <!-- Games List Container -->
                <Border Grid.Row="1"
                        Background="#141316"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="4">
                    <Grid>
                        <ListBox x:Name="ListGames"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="ListGames_SelectionChanged"
                                 MouseDoubleClick="ListGames_MouseDoubleClick">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="8,6" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="itemBorder"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="itemBorder" Property="Background" Value="#26222A" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="itemBorder" Property="Background" Value="#351F26" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4,2,8,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Cover Thumbnail -->
                                        <Border Grid.Column="0"
                                                Width="32" Height="42"
                                                CornerRadius="4"
                                                Background="#252128"
                                                ClipToBounds="True">
                                            <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />
                                        </Border>

                                        <!-- Title Info -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,12,0">
                                            <TextBlock Text="{Binding DisplayTitle}"
                                                       FontWeight="SemiBold"
                                                       FontSize="13"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ReleaseDateYear, StringFormat='Year: {0}'}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextMutedBrush}" />
                                        </StackPanel>

                                        <!-- Current Logged Hours Chip -->
                                        <Border Grid.Column="2"
                                                Background="#211E24"
                                                CornerRadius="4"
                                                Padding="8,3"
                                                Margin="0,0,6,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ProgressDisplay}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource RosePrimaryBrush}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock x:Name="TxtNoGamesFound"
                                   Text="No matching games found in your IRIS list."
                                   FontSize="12"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed" />
                    </Grid>
                </Border>
            </Grid>

            <!-- TAB 2: EXECUTABLE & PROCESS -->
            <ScrollViewer x:Name="ViewProcess"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Card 1: Active Running Windows -->
                    <Border Background="{StaticResource BgCardBrush}"
                            BorderBrush="{StaticResource BorderDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="RUNNING WINDOWS" Style="{StaticResource FieldLabel}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="CmbRunningWindows"
                                          Grid.Column="0"
                                          Height="34"
                                          DisplayMemberPath="DisplayText"
                                          SelectionChanged="CmbRunningWindows_SelectionChanged" />
                                <Button x:Name="BtnRefreshWindows"
                                        Grid.Column="1"
                                        Content="Refresh"
                                        Style="{StaticResource SecondaryButton}"
                                        Height="34"
                                        Margin="8,0,0,0"
                                        Padding="12,0"
                                        Click="BtnRefreshWindows_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Card 2: Executable Input & Browse -->
                    <Border Background="{StaticResource BgCardBrush}"
                            BorderBrush="{StaticResource BorderDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="EXECUTABLE NAME" Style="{StaticResource FieldLabel}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtExecutableName"
                                         Grid.Column="0"
                                         Height="34"
                                         TextChanged="TxtExecutableName_TextChanged" />
                                <Button x:Name="BtnBrowseExe"
                                        Grid.Column="1"
                                        Content="Browse..."
                                        Style="{StaticResource SecondaryButton}"
                                        Height="34"
                                        Margin="8,0,0,0"
                                        Padding="12,0"
                                        Click="BtnBrowseExe_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Card 3: Window Title Pattern (Optional) -->
                    <Border Background="{StaticResource BgCardBrush}"
                            BorderBrush="{StaticResource BorderDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16">
                        <StackPanel>
                            <TextBlock Text="WINDOW TITLE PATTERN (OPTIONAL)" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="TxtWindowTitlePattern"
                                     Height="34"
                                     TextChanged="TxtWindowTitlePattern_TextChanged" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Footer Actions -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <!-- Selected Game Indicator (Clean micro pill on left) -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                <Border x:Name="PillSelectedGame"
                        Background="#231F28"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="10,4"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{StaticResource RosePrimaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtSelectedGameName"
                                   Text=""
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Buttons on right -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnCancel"
                        Content="Cancel"
                        Style="{StaticResource SecondaryButton}"
                        Height="34"
                        Width="85"
                        Margin="0,0,8,0"
                        Click="BtnCancel_Click" />

                <Button x:Name="BtnLink"
                        Content="Add"
                        Style="{StaticResource PrimaryButton}"
                        Height="34"
                        Padding="18,0"
                        IsEnabled="False"
                        Click="BtnLink_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
