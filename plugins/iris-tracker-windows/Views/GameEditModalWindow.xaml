<Window x:Class="IrisTracker.Views.GameEditModalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Manage Detections"
        Height="500" Width="520"
        MinHeight="440" MinWidth="460"
        WindowStartupLocation="CenterOwner"
        Background="#121114"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Window.Resources>
        <!-- Uppercase Section Label -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header Banner -->
            <RowDefinition Height="Auto" />
            <!-- Content Area (Detections Only) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header Banner Area -->
        <Border Grid.Row="0"
                Background="#1A171F"
                BorderBrush="{StaticResource BorderDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Cover Image -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Title -->
                    <ColumnDefinition Width="*" />
                    <!-- Actions (Save, Close) -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Cover Image Thumbnail -->
                <Border Grid.Column="0"
                        Width="52" Height="70"
                        CornerRadius="8"
                        Background="#26222A"
                        BorderBrush="{StaticResource BorderDefaultBrush}"
                        BorderThickness="1"
                        ClipToBounds="True"
                        Margin="0,0,14,0"
                        VerticalAlignment="Center">
                    <Image x:Name="ImgCover" Stretch="UniformToFill" />
                </Border>

                <!-- Title -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock x:Name="TxtTitle"
                               Text="Game Title"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"
                               TextWrapping="Wrap"
                               MaxHeight="46"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Right Actions: Save, Close -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Save Button (Rose Background, High-Contrast White Text) -->
                    <Button x:Name="BtnSave"
                            Content="Save"
                            Style="{StaticResource RosePillButton}"
                            Margin="0,0,10,0"
                            Click="BtnSave_Click" />

                    <!-- Close Button -->
                    <Button Style="{StaticResource CircleCloseButton}"
                            Click="BtnClose_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Detections Main Content Area -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="20,16,20,16">
            <StackPanel>
                <!-- Card 1: Currently Tracked Executables -->
                <Border Background="#1A171E"
                        BorderBrush="{StaticResource BorderDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="TRACKED EXECUTABLES" Style="{StaticResource FieldLabel}" />

                        <ListBox x:Name="ListTrackedExes"
                                 Background="#141217"
                                 BorderBrush="{StaticResource BorderSubtleBrush}"
                                 BorderThickness="1"
                                 MaxHeight="140"
                                 Margin="0,0,0,4">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="10,6" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding}"
                                                       FontSize="12"
                                                       FontFamily="Consolas, Cascadia Code, monospace"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="✕ Remove"
                                                Style="{StaticResource DangerButton}"
                                                FontSize="10"
                                                Padding="8,2"
                                                Click="BtnRemoveExe_Click"
                                                Tag="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock x:Name="TxtNoDetections"
                                   Text="No executables configured yet."
                                   FontSize="11"
                                   Foreground="{StaticResource TextDimBrush}"
                                   Margin="0,4,0,0"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!-- Card 2: Add Executable To Track -->
                <Border Background="#1A171E"
                        BorderBrush="{StaticResource BorderDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="ADD EXECUTABLE TO TRACK" Style="{StaticResource FieldLabel}" Margin="0,0,0,8" />

                        <!-- Pick Active Running Window -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CmbRunningWindows"
                                      Grid.Column="0"
                                      Height="34"
                                      DisplayMemberPath="DisplayText" />
                            <Button Grid.Column="1"
                                    Content="+ Add Process"
                                    Style="{StaticResource SecondaryButton}"
                                    Height="34"
                                    Margin="8,0,0,0"
                                    Padding="10,0"
                                    Click="BtnAddFromRunning_Click" />
                        </Grid>

                        <!-- Manual Entry / Browse -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtNewExe"
                                     Grid.Column="0"
                                     Height="34" />
                            <Button Grid.Column="1"
                                    Content="Browse..."
                                    Style="{StaticResource SecondaryButton}"
                                    Height="34"
                                    Margin="8,0,0,0"
                                    Padding="10,0"
                                    Click="BtnBrowse_Click" />
                            <Button Grid.Column="2"
                                    Content="+ Add"
                                    Style="{StaticResource PrimaryButton}"
                                    Height="34"
                                    Margin="8,0,0,0"
                                    Padding="12,0"
                                    Click="BtnAddManual_Click" />
                        </Grid>

                        <!-- Window Title Pattern (Optional) -->
                        <TextBlock Text="WINDOW TITLE PATTERN (OPTIONAL)" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="TxtWindowTitlePattern"
                                 Height="34" />
                    </StackPanel>
                </Border>

                <!-- Card 3: Danger Zone / Unlink Game Button -->
                <Border Background="#211417"
                        BorderBrush="#441E22"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="UNLINK FROM TRACKER"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#F87171"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Content="Unlink Game"
                                Style="{StaticResource DangerButton}"
                                Padding="14,6"
                                Click="BtnUnlinkGame_Click" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
