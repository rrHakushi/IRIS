<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BorealisExtra.MainWindow"
        Title="Borealis Extra"
        Icon="/Assets/iris.ico"
        Width="980" Height="700"
        MinWidth="840" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}">

  <Panel>
    <ContentControl x:Name="RootContainer" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
  </Panel>
</Window>
