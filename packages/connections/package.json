{
  "name": "@IRIS/connections",
  "version": "1.0.0",
  "private": true,
  "description": "Unified 3rd-party connection adapters, encrypted credential storage, and proxy manager for IRIS",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/test/connections.spec.ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@IRIS/cache": "workspace:*",
    "@IRIS/database": "workspace:*",
