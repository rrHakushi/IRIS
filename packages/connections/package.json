    "@noble/hashes": "^2.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@workspace/typescript-config": "workspace:*",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
