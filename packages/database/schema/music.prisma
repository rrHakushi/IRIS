// use prisma-8

enum MusicType {
    TRACK
    ALBUM
}

model Music {
    id             Int         @id @default(autoincrement())
    type           MusicType   @default(TRACK)
    deezerId       String?     @unique
    isrc           String?
    upc            String?     // Album barcode / UPC

    titlePrimary   String
    titleSecondary String? // title_short
    titleVersion   String?
    titleNative    String?

    link           String?
    share          String?

    coverImage     String?
    images         Jsonb? // { small, medium, big, xl }
    md5Image       String?

    duration       Int?        // Duration in seconds
    trackPosition  Int?
    diskNumber     Int?        @default(1)
    rank           Int?

    releaseDate      DateTime?
    releaseDateYear  Int?
    releaseDateMonth Int?
    releaseDateDay   Int?

    explicitLyrics         Boolean  @default(false)
    explicitContentLyrics  Int?     @default(0)
    explicitContentCover   Int?     @default(0)

    audioPreviewUrl String?
    bpm             Float?
    gain            Float?
    availableCountries String[] @default([])

    recordType     String?     // "album", "single", "compile", "ep"
    label          String?
    nbTracks       Int?
    fans           Int?        @default(0)

    lyrics         String?
    syncedLyrics   String?
    lyricsSource   String?

    description    String?
    status         MediaStatus @default(RELEASED)
    sources        Jsonb?
    deezerUpdatedAt Int?

    // Local platform stats (application metrics)
    listeners      Int         @default(0)
    playCount      Int         @default(0)
    favorites      Int         @default(0)
    popularity     Int         @default(0)

    // Album <-> Tracks self-relation
    albumId        Int?
    album          Music?      @relation("MusicAlbumTracks", fields: [albumId], references: [id], onDelete: Cascade)
    tracks         Music[]     @relation("MusicAlbumTracks")

    // Artist relation
    artistId       Int?
    artist         Person?     @relation("MusicArtist", fields: [artistId], references: [id], onDelete: SetNull)
    artistName     String?
    deezerArtistId String?

    // Media relations
    staff          MediaStaff[]
    genres MusicGenre[]
    tags MusicTag[]
    userLists      MusicList[]
    reviews        MusicReview[]
    customListEntries CustomListEntry[]

    createdAt      DateTime    @default(now())
    updatedAt      DateTime    @onCreate(now()) @onUpdate(now())

    @@index([titlePrimary])
    @@index([artistName])
    @@index([type])
    @@index([albumId])
    @@index([popularity])
    @@index([rank])
}
