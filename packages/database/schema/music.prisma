enum MusicType {
    TRACK
    ALBUM
}

enum MusicStatus {
    RELEASED
    UPCOMING
    CANCELLED
    UNKNOWN
}

model Music {
    id             Int         @id @default(autoincrement())
    type           MusicType   @default(TRACK)
    deezerId       String?     @unique
    isrc           String?
    upc            String?     // Album barcode / UPC

    titlePrimary   String      @db.Text
    titleSecondary String?     @db.Text // title_short
    titleVersion   String?     @db.Text
    titleNative    String?     @db.Text

    link           String?     @db.Text
    share          String?     @db.Text

    coverImage     String?     @db.Text
    images         Json?       @db.JsonB // { small, medium, big, xl }
    md5Image       String?

    duration       Int?        // Duration in seconds
    trackPosition  Int?
    diskNumber     Int?        @default(1)
    rank           Int?

    releaseDate      DateTime?
    releaseDateYear  Int?
    releaseDateMonth Int?
    releaseDateDay   Int?

    explicitLyrics         Boolean  @default(false)
    explicitContentLyrics  Int?     @default(0)
    explicitContentCover   Int?     @default(0)

    audioPreviewUrl String?    @db.Text
    bpm             Float?
    gain            Float?
    availableCountries String[] @default([])

    recordType     String?     // "album", "single", "compile", "ep"
    label          String?     @db.Text
    nbTracks       Int?
    fans           Int?        @default(0)

    lyrics         String?     @db.Text
    syncedLyrics   String?     @db.Text
    lyricsSource   String?

    description    String?     @db.Text
    status         MusicStatus @default(RELEASED)
    sources        Json?       @db.JsonB
    deezerUpdatedAt Int?

    // Local platform stats (application metrics)
    listeners      Int         @default(0)
    playCount      Int         @default(0)
    favorites      Int         @default(0)
    popularity     Int         @default(0)

    // Album <-> Tracks self-relation
    albumId        Int?
    album          Music?      @relation("MusicAlbumTracks", fields: [albumId], references: [id], onDelete: Cascade)
    tracks         Music[]     @relation("MusicAlbumTracks")

    // Artist relation
    artistId       Int?
    artist         Person?     @relation("MusicArtist", fields: [artistId], references: [id], onDelete: SetNull)
    artistName     String?     @db.Text
    deezerArtistId String?

    // Media relations
    staff          MediaStaff[]
    genres         Genre[]
    tags           Tag[]
    userLists      MusicList[]
    reviews        MusicReview[]
    customListEntries CustomListEntry[]

    createdAt      DateTime    @default(now())
    updatedAt      DateTime    @updatedAt

    @@index([titlePrimary])
    @@index([artistName])
    @@index([type])
    @@index([albumId])
    @@index([popularity(sort: Desc)])
    @@index([rank(sort: Desc)])
}
