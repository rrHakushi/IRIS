// use prisma-8

enum StaffRole {
    DIRECTOR
    EPISODE_DIRECTOR
    CHIEF_ANIMATION_DIRECTOR
    CHARACTER_DESIGN
    ART_DIRECTOR
    COMPOSER
    SOUND_DIRECTOR
    ORIGINAL_CREATOR
    SCRIPT
    KEY_ANIMATION
    COLOR_DESIGN
    PRODUCER
    EXECUTIVE_PRODUCER
    AUTHOR
    ILLUSTRATOR
    CAST
    ARTIST
    FEATURED_ARTIST
    LYRICIST
    ARRANGER
    OTHER
}

model Person {
    id Int @id @default(autoincrement())

    // Provider External IDs
    anilistId   Int?    @unique
    malId       Int?    @unique
    aniDBId     Int?    @unique
    tvDBId      Int?    @unique
    bangumiId   Int?    @unique
    imdbId      String? @unique
    tmdbId      Int?    @unique
    deezerId    String? @unique
    lastFmUrl   String? @unique
    spotifyId   String? @unique

    // Names & Identity
    namePrimary     String
    nameNative      String?
    nameAlternative String[]
    givenName       String?
    familyName      String?

    // Visuals (main image and sized variations in images JSON)
    image  String?
    images Jsonb? // { small, medium, big, xl, original }

    // Biography & Profile
    description        String?
    gender             String?
    bloodType          String?
    homeTown           String?
    birthPlace         String?
    language           String?
    primaryOccupations String[] @default([])

    // Birth & Death Details
    dateOfBirth      DateTime?
    dateOfBirthYear  Int?
    dateOfBirthMonth Int?
    dateOfBirthDay   Int?
    dateOfDeath      DateTime?
    dateOfDeathYear  Int?
    dateOfDeathMonth Int?
    dateOfDeathDay   Int?
    age              Int?
    yearsActive      Int[]    @default([])

    // Deezer Artist Specific Fields
    nbAlbum     Int?     @default(0)
    nbFan       Int?     @default(0)
    deezerLink  String?
    deezerShare String?
    hasRadio    Boolean? @default(false)

    // Local platform stats (application metrics)
    favorites Int? @default(0)

    // Sources & Raw metadata
    sources Jsonb?

    createdAt DateTime @default(now())
    updatedAt DateTime @onCreate(now()) @onUpdate(now())

    mediaStaff       MediaStaff[]
    voicedCharacters MediaCharacter[]
    musicTracks      Music[]          @relation("MusicArtist")

    @@index([namePrimary])
    @@index([deezerId])
    @@index([tvDBId])
    @@index([anilistId])
}

model MediaStaff {
    id         Int       @id @default(autoincrement())
    mediaType  MediaType @default(ANIME)
    mediaId    Int
    personId   Int
    role       StaffRole @default(OTHER)
    customRole String?

    animeId Int?
    mangaId Int?
    movieId Int?
    tvId    Int?
    bookId  Int?
    musicId Int?

    person Person @relation(fields: [personId], references: [id], onDelete: Cascade)
    anime  Anime? @relation(fields: [animeId], references: [id], onDelete: Cascade)
    manga  Manga? @relation(fields: [mangaId], references: [id], onDelete: Cascade)
    movie  Movie? @relation(fields: [movieId], references: [id], onDelete: Cascade)
    tv     Tv?    @relation(fields: [tvId], references: [id], onDelete: Cascade)
    book   Book?  @relation(fields: [bookId], references: [id], onDelete: Cascade)
    music  Music? @relation(fields: [musicId], references: [id], onDelete: Cascade)

    @@unique([mediaType, mediaId, personId, role])
    @@index([mediaType, mediaId])
    @@index([personId])
    @@index([musicId])
}
