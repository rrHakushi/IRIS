// use prisma-8

model Genre {
    id        Int      @id @default(autoincrement())
    name String @unique
    slug String @unique

    anime AnimeGenre[]
    manga MangaGenre[]
    movies MovieGenre[]
    tv TvGenre[]
    games GameGenre[]
    books BookGenre[]
    music MusicGenre[]

    createdAt DateTime @default(now())
    updatedAt DateTime @onCreate(now()) @onUpdate(now())

    @@index([slug])
    @@index([name])
}
