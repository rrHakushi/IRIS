// use prisma-8

enum MediaType {
    ANIME
    MANGA
    MOVIE
    TV
    GAME
    BOOK
    MUSIC
    MUSIC_ALBUM
    MUSIC_TRACK
    OTHER
    UNKNOWN
}

// Unified release status shared by every media type (anime, manga, tv, movie, game, book, music)
enum MediaStatus {
    RELEASED
    RELEASING
    UPCOMING
    CANCELLED
    HIATUS
    UNKNOWN
}

// Unified user list status shared by every list type
enum ListStatus {
    IN_PROGRESS
    ON_HOLD
    DROPPED
    COMPLETED
    PLANNED
}

model CustomList {
    id          String   @id @onCreate(uuid())
    userId      String
    user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    name        String
    description String?
    isDefault   Boolean  @default(false)
    isPrivate   Boolean  @default(false)
    coverImage  String?
    order       Int      @default(0)

    entries CustomListEntry[]

    createdAt DateTime @default(now())
    updatedAt DateTime @onCreate(now()) @onUpdate(now())

    @@index([userId])
    @@index([userId, isDefault])
}

model CustomListEntry {
    id          String     @id @onCreate(uuid())
    listId      String
    customList  CustomList @relation(fields: [listId], references: [id], onDelete: Cascade)

    mediaType   MediaType
    mediaId     Int
    order       Int        @default(0)
    customNotes String?
    addedAt     DateTime   @default(now())

    animeId Int?
    mangaId Int?
    movieId Int?
    tvId    Int?
    gameId  Int?
    bookId  Int?
    musicId Int?
    otherId Int?

    anime Anime? @relation(fields: [animeId], references: [id], onDelete: Cascade)
    manga Manga? @relation(fields: [mangaId], references: [id], onDelete: Cascade)
    movie Movie? @relation(fields: [movieId], references: [id], onDelete: Cascade)
    tv    Tv?    @relation(fields: [tvId], references: [id], onDelete: Cascade)
    game  Game?  @relation(fields: [gameId], references: [id], onDelete: Cascade)
    book  Book?  @relation(fields: [bookId], references: [id], onDelete: Cascade)
    music Music? @relation(fields: [musicId], references: [id], onDelete: Cascade)
    other Other? @relation(fields: [otherId], references: [id], onDelete: Cascade)

    @@unique([listId, mediaType, mediaId])
    @@index([listId])
    @@index([mediaType, mediaId])
}

model AnimeList {
    id          Int             @id @default(autoincrement())
    userId      String
    user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
    animeId     Int
    anime       Anime           @relation(fields: [animeId], references: [id], onDelete: Cascade)
    status      ListStatus      @default(PLANNED)
    progress    Int             @default(0)
    score       Float?
    notes       String?
    rewatched   Int             @default(0)
    private     Boolean         @default(false)

    startedAt      DateTime?
    completedAt    DateTime?
    rewatchHistory Jsonb?
    connections    Jsonb?

    createdAt DateTime @default(now())
    updatedAt DateTime @onCreate(now()) @onUpdate(now())

    @@unique([userId, animeId])
    @@index([userId])
    @@index([animeId])
    @@index([status])
    @@index([userId, status])
    @@index([userId, score])
}

model MangaList {
    id               Int             @id @default(autoincrement())
    userId           String
    user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
    mangaId          Int
    manga            Manga           @relation(fields: [mangaId], references: [id], onDelete: Cascade)
    status           ListStatus      @default(PLANNED)
    chaptersProgress Int             @default(0)
    volumesProgress  Int             @default(0)
    score            Float?
    notes            String?
    reread           Int             @default(0)
    private          Boolean         @default(false)

    startedAt     DateTime?
    completedAt   DateTime?
    rereadHistory Jsonb?
    connections   Jsonb?

    createdAt DateTime @default(now())
    updatedAt DateTime @onCreate(now()) @onUpdate(now())

    @@unique([userId, mangaId])
    @@index([userId])
    @@index([mangaId])
    @@index([status])
    @@index([userId, status])
    @@index([userId, score])
}

model MovieList {
    id          Int             @id @default(autoincrement())
    userId      String
    user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
    movieId     Int
    movie       Movie           @relation(fields: [movieId], references: [id], onDelete: Cascade)
    status      ListStatus      @default(PLANNED)
    score       Float?
    notes       String?
    rewatched   Int             @default(0)
    private     Boolean         @default(false)

    startedAt      DateTime?
    completedAt    DateTime?
    rewatchHistory Jsonb?
    connections    Jsonb?

    createdAt DateTime @default(now())
    updatedAt DateTime @onCreate(now()) @onUpdate(now())

    @@unique([userId, movieId])
    @@index([userId])
    @@index([movieId])
    @@index([status])
    @@index([userId, status])
    @@index([userId, score])
}

model TvList {
    id          Int          @id @default(autoincrement())
    userId      String
    user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
    tvId        Int
    tv          Tv           @relation(fields: [tvId], references: [id], onDelete: Cascade)
    status      ListStatus   @default(PLANNED)
    progress    Int          @default(0)
    score       Float?
    notes       String?
    rewatched   Int          @default(0)
    private     Boolean      @default(false)

    startedAt      DateTime?
    completedAt    DateTime?
    rewatchHistory Jsonb?
    connections    Jsonb?

    seasons         TvSeasonProgress[]
    watchedEpisodes TvWatchedEpisode[]

    createdAt DateTime @default(now())
    updatedAt DateTime @onCreate(now()) @onUpdate(now())

    @@unique([userId, tvId])
    @@index([userId])
    @@index([tvId])
    @@index([status])
    @@index([userId, status])
    @@index([userId, score])
}

model TvSeasonProgress {
    id           Int          @id @default(autoincrement())
    tvListId     Int
    tvList       TvList       @relation(fields: [tvListId], references: [id], onDelete: Cascade)
    seasonId     Int
    season       TvSeason     @relation(fields: [seasonId], references: [id], onDelete: Cascade)
    seasonNumber Int
    status       ListStatus   @default(PLANNED)
    progress     Int          @default(0)
    score        Float?
    notes        String?
    rewatched    Int          @default(0)

    startedAt      DateTime?
    completedAt    DateTime?
    rewatchHistory Jsonb?

    createdAt DateTime @default(now())
    updatedAt DateTime @onCreate(now()) @onUpdate(now())

    @@unique([tvListId, seasonNumber])
    @@index([tvListId])
    @@index([seasonId])
}

model TvWatchedEpisode {
    id            Int        @id @default(autoincrement())
    tvListId      Int
    tvList        TvList     @relation(fields: [tvListId], references: [id], onDelete: Cascade)
    episodeId     Int?
    episode       TvEpisode? @relation(fields: [episodeId], references: [id], onDelete: SetNull)
    seasonNumber  Int
    episodeNumber Int
    watchedAt     DateTime   @default(now())

    @@unique([tvListId, seasonNumber, episodeNumber])
    @@index([tvListId])
    @@index([episodeId])
}

model GameList {
    id          Int            @id @default(autoincrement())
    userId      String
    user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
    gameId      Int
    game        Game           @relation(fields: [gameId], references: [id], onDelete: Cascade)
    status      ListStatus     @default(PLANNED)
    progress    Int            @default(0)
    score       Float?
    notes       String?
    replayed    Int            @default(0)
    private     Boolean        @default(false)

    startedAt     DateTime?
    completedAt   DateTime?
    replayHistory Jsonb?
    connections   Jsonb?

    createdAt DateTime @default(now())
    updatedAt DateTime @onCreate(now()) @onUpdate(now())

    @@unique([userId, gameId])
    @@index([userId])
    @@index([gameId])
    @@index([status])
    @@index([userId, status])
    @@index([userId, score])
}

model BookList {
    id               Int            @id @default(autoincrement())
    userId           String
    user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
    bookId           Int
    book             Book           @relation(fields: [bookId], references: [id], onDelete: Cascade)
    status           ListStatus     @default(PLANNED)
    progressPages    Int            @default(0)
    progressChapters Int            @default(0)
    progressVolumes  Int            @default(0)
    score            Float?
    notes            String?
    reread           Int            @default(0)
    private          Boolean        @default(false)

    startedAt     DateTime?
    completedAt   DateTime?
    rereadHistory Jsonb?
    connections   Jsonb?

    createdAt DateTime @default(now())
    updatedAt DateTime @onCreate(now()) @onUpdate(now())

    @@unique([userId, bookId])
    @@index([userId])
    @@index([bookId])
    @@index([status])
    @@index([userId, status])
    @@index([userId, score])
}

model MusicList {
    id          Int             @id @default(autoincrement())
    userId      String
    user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
    musicId     Int
    music       Music           @relation(fields: [musicId], references: [id], onDelete: Cascade)
    status      ListStatus      @default(PLANNED)
    score       Float?
    playCount   Int             @default(0)
    notes       String?
    private     Boolean         @default(false)
    startedAt   DateTime?
    completedAt DateTime?
    connections Jsonb?

    createdAt   DateTime        @default(now())
    updatedAt   DateTime        @onCreate(now()) @onUpdate(now())

    @@unique([userId, musicId])
    @@index([userId])
    @@index([musicId])
    @@index([status])
    @@index([userId, status])
    @@index([userId, score])
}

model ListComment {
    id          String             @id @onCreate(uuid())
    listOwnerId String
    listOwner   User               @relation("ListOwnerComments", fields: [listOwnerId], references: [id], onDelete: Cascade)
    mediaType   String             // "anime" | "manga" | "movie" | "tv" | "game" | "book" | "music"
    authorId    String
    author      User               @relation("AuthorListComments", fields: [authorId], references: [id], onDelete: Cascade)
    content     String
    isSpoiler   Boolean            @default(false)
    reply       ListCommentReply?
    createdAt   DateTime           @default(now())
    updatedAt   DateTime           @onCreate(now()) @onUpdate(now())

    @@index([listOwnerId, mediaType, createdAt])
    @@index([authorId])
}

model ListCommentReply {
    id        String      @id @onCreate(uuid())
    commentId String      @unique
    comment   ListComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
    authorId  String
    author    User        @relation("AuthorListCommentReplies", fields: [authorId], references: [id], onDelete: Cascade)
    content   String
    createdAt DateTime    @default(now())
    updatedAt DateTime    @onCreate(now()) @onUpdate(now())

    @@index([authorId])
}

model ListExportShare {
    id           String    @id @onCreate(uuid())
    userId       String
    user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    passwordHash String
    mediaTypes   String[]
    description  String?
    expiresAt    DateTime?
    lastUsedAt   DateTime?
    createdAt    DateTime  @default(now())
    updatedAt    DateTime  @onCreate(now()) @onUpdate(now())

    @@index([userId])
}
