model Tag {
    id          Int      @id @default(autoincrement())
    name        String   @unique @db.Text
    slug        String   @unique @db.Text
    category    String?  @db.Text
    description String?  @db.Text

    anime       Anime[]
    manga       Manga[]
    movies      Movie[]
    tv          Tv[]
    games       Game[]
    books       Book[]
    albums      MusicAlbum[]
    tracks      MusicTrack[]

    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    @@index([slug])
    @@index([name])
    @@index([category])
}
