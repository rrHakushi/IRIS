// use prisma-8

model Tag {
    id          Int      @id @default(autoincrement())
    name String @unique
    slug String @unique
    category    String?
    description String?

    anime AnimeTag[]
    manga MangaTag[]
    movies MovieTag[]
    tv TvTag[]
    games GameTag[]
    books BookTag[]
    music MusicTag[]

    createdAt   DateTime @default(now())
    updatedAt   DateTime @onCreate(now()) @onUpdate(now())

    @@index([slug])
    @@index([name])
    @@index([category])
}
