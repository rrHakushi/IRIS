// use prisma-8

enum AnimeSeason {
    WINTER
    SPRING
    SUMMER
    FALL
    UNKNOWN
}

enum AnimeSource {
    ORIGINAL
    MANGA
    LIGHT_NOVEL
    VISUAL_NOVEL
    VIDEO_GAME
    OTHER
    NOVEL
    DOUJINSHI
    ANIME
    WEB_NOVEL
    LIVE_ACTION
    GAME
    COMIC
    MULTIMEDIA_PROJECT
    PICTURE_BOOK
    UNKNOWN
}

enum AnimeFormat {
    TV
    TV_SHORT
    MOVIE
    SPECIAL
    OVA
    ONA
    MUSIC
    UNKNOWN
}

enum EpisodeType {
    REGULAR
    SPECIAL
    OVA
    ONA
    MOVIE
    OTHER
}

model Anime {
    id        Int  @id @default(autoincrement())
    anilistId Int? @unique
    malId     Int? @unique
    aniDBId   Int?
    tvDBId    Int?
    bangumiId Int?
    kitsuId   Int?

    titlePrimary   String
    titleSecondary String?
    titleNative    String?

    coverImage  String?
    bannerImage String?
    images      Jsonb?

    description     String?
    hashtag         String?
    countryOfOrigin String?

    episodeCount    Int?
    episodeDuration Int?
    episodes        AnimeEpisode[]
    airingSchedule  AnimeAiringSchedule[]

    startDateYear  Int?
    startDateMonth Int?
    startDateDay   Int?

    endDateYear  Int?
    endDateMonth Int?
    endDateDay   Int?

    genres AnimeGenre[]
    tags AnimeTag[]
    source       AnimeSource @default(UNKNOWN)
    format       AnimeFormat @default(UNKNOWN)
    status       MediaStatus @default(UNKNOWN)
    seasonSeason AnimeSeason @default(UNKNOWN)
    seasonYear   Int?

    averageScore       Float?
    favorites          Int    @default(0)
    popularity         Int    @default(0)
    totalScoreSum      Int?
    scoredCount        Int?
    statusDistribution Jsonb @default(json`{}`)
    scoreDistribution Jsonb @default(json`{}`)

    alAverageScore Int?
    alFavorites    Int?
    alPopularity   Int?

    malAverageScore Int?
    malFavorites    Int?
    malPopularity   Int?

    isAdult  Boolean  @default(false)
    synonyms String[]
    trailers Jsonb?
    locked   Boolean  @default(false)

    siteUrl       String?
    externalLinks Jsonb?
    sources       Jsonb?

    themeSongs Jsonb?

    ageRating      String?
    ageRatingGuide String?

    nextAiringEpisodeNumber Int?
    nextAiringAt            DateTime?

    alUpdatedAt    Int?
    malUpdatedAt   Int?
    anidbUpdatedAt Int?

    createdAt DateTime @default(now())
    updatedAt DateTime @onCreate(now()) @onUpdate(now())

    characters       MediaCharacter[]
    studios          MediaStudio[]
    staff            MediaStaff[]
    userLists        AnimeList[]
    reviews          AnimeReview[]
    customListEntries CustomListEntry[]

    @@index([titlePrimary])
    @@index([status])
    @@index([format])
    @@index([seasonYear, seasonSeason])
    @@index([popularity])
    @@index([averageScore])
    @@index([nextAiringAt])
    @@index([tvDBId])
}

model AnimeEpisode {
    id      Int         @id @default(autoincrement())
    animeId Int
    anime   Anime       @relation(fields: [animeId], references: [id], onDelete: Cascade)
    number  Int
    type    EpisodeType @default(REGULAR)

    titlePrimary   String
    titleSecondary String?
    titleNative    String?

    description    String?
    duration       Int?
    airDate        DateTime?
    thumbnail      String?
    isFiller       Boolean   @default(false)
    isRecap        Boolean   @default(false)
    streamingLinks Jsonb?

    opStart    Int?
    opEnd      Int?
    edStart    Int?
    edEnd      Int?
    recapStart Int?
    recapEnd   Int?

    skipTimestamps Jsonb?

    anidbEpisodeId Int?
    createdAt      DateTime @default(now())
    updatedAt      DateTime @onCreate(now()) @onUpdate(now())

    @@unique([animeId, number, type])
    @@index([animeId])
    @@index([airDate])
}

model AnimeAiringSchedule {
    id              Int      @id @default(autoincrement())
    animeId         Int
    anime           Anime    @relation(fields: [animeId], references: [id], onDelete: Cascade)
    episodeNumber   Int
    airingAt        DateTime
    anilistAiringId Int?     @unique
    createdAt       DateTime @default(now())
    updatedAt       DateTime @onCreate(now()) @onUpdate(now())

    @@unique([animeId, episodeNumber])
    @@index([animeId])
    @@index([airingAt])
}
