model MusicReview {
    id        Int           @id @default(autoincrement())
    userId    String
    user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
    itemType  MusicItemType @default(ALBUM)
    albumId   Int?
    album     MusicAlbum?   @relation(fields: [albumId], references: [id], onDelete: Cascade)
    trackId   Int?
    track     MusicTrack?   @relation(fields: [trackId], references: [id], onDelete: Cascade)
    summary   String        @db.Text
    body      String        @db.Text
    score     Float
    upvotes   Int           @default(0)
    downvotes Int           @default(0)
    isSpoiler Boolean       @default(false)
    ratings   Json?         @db.JsonB

    createdAt DateTime      @default(now())
    updatedAt DateTime      @updatedAt

    @@unique([userId, albumId])
    @@unique([userId, trackId])
    @@index([albumId])
    @@index([trackId])
    @@index([userId])
    @@index([itemType])
    @@index([score(sort: Desc)])
}

model ReviewVote {
    id         Int            @id @default(autoincrement())
    userId     String
    user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
    reviewType MediaType
    reviewId   Int
    voteType   ReviewVoteType

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([userId, reviewType, reviewId])
    @@index([reviewType, reviewId])
    @@index([userId])
}
