// use prisma-8

enum MangaFormat {
    MANGA
    NOVEL
    LIGHT_NOVEL
    ONE_SHOT
    MANHWA
    MANHUA
    UNKNOWN
}

model Manga {
    id             Int     @id @default(autoincrement())
    anilistId      Int?    @unique
    malId          Int?    @unique
    mangaUpdatesId String?
    kitsuId        Int?
    bangumiId      Int?

    titlePrimary   String
    titleSecondary String?
    titleNative    String?

    coverImage  String?
    bannerImage String?
    images      Jsonb?

    description     String?
    countryOfOrigin String?

    volumeCount  Int?
    chapterCount Int?

    startDateYear  Int?
    startDateMonth Int?
    startDateDay   Int?

    endDateYear  Int?
    endDateMonth Int?
    endDateDay   Int?

    genres MangaGenre[]
    tags MangaTag[]
    source AnimeSource @default(UNKNOWN)
    format MangaFormat @default(UNKNOWN)
    status MediaStatus @default(UNKNOWN)

    averageScore       Float?
    favorites          Int    @default(0)
    popularity         Int    @default(0)
    totalScoreSum      Int?
    scoredCount        Int?
    statusDistribution Jsonb @default(json`{}`)
    scoreDistribution Jsonb @default(json`{}`)

    alAverageScore Int?
    alFavorites    Int?
    alPopularity   Int?

    malAverageScore Int?
    malFavorites    Int?
    malPopularity   Int?

    isAdult  Boolean  @default(false)
    synonyms String[]
    locked   Boolean  @default(false)

    siteUrl       String?
    externalLinks Jsonb?
    sources       Jsonb?

    ageRating      String?
    ageRatingGuide String?

    alUpdatedAt  Int?
    malUpdatedAt Int?

    createdAt DateTime @default(now())
    updatedAt DateTime @onCreate(now()) @onUpdate(now())

    characters       MediaCharacter[]
    staff            MediaStaff[]
    userLists        MangaList[]
    reviews          MangaReview[]
    customListEntries CustomListEntry[]

    @@index([titlePrimary])
    @@index([status])
    @@index([format])
    @@index([popularity])
    @@index([averageScore])
}
