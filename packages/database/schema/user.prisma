model User {
    id String @id @default(uuid())

    username          String    @unique
    email             String    @unique
    passwordHash      String    @db.Text
    passwordChangedAt DateTime?

    customization Json? @db.Json

    settings    Json? @db.Json
    permissions Int[] @default([])

    // MFA
    TOTPSecret      String?
    TOTPEnabled     Boolean   @default(false)
    emailMfaEnabled Boolean   @default(false)
    backupCodes     String[]  @default([])
    passkeys        Passkey[]
    apiKeys         ApiKey[]
    notifications   Notification[]
    connections     Connection[]

    // MEDIA LISTS & PLAYLISTS
    customLists     CustomList[]
    animeList       AnimeList[]
    mangaList       MangaList[]
    movieList       MovieList[]
    tvList          TvList[]
    gameList        GameList[]
    bookList        BookList[]
    musicList       MusicList[]
    exportShares    ListExportShare[]
    listOwnerComments          ListComment[]      @relation("ListOwnerComments")
    authoredListComments       ListComment[]      @relation("AuthorListComments")
    authoredListCommentReplies ListCommentReply[] @relation("AuthorListCommentReplies")

    // REVIEWS & SOCIAL
    animeReviews        AnimeReview[]
    mangaReviews        MangaReview[]
    movieReviews        MovieReview[]
    tvReviews           TvReview[]
    gameReviews         GameReview[]
    bookReviews         BookReview[]
    musicReviews        MusicReview[]
    reviewVotes         ReviewVote[]
    recommendations     MediaRecommendation[]
    recommendationVotes MediaRecommendationVote[]
    favorites           Favorite[]

    // STATS & ACTIVITY
    userStats       UserStats[]
    activityLogs    ActivityLog[]
    activityLikes   ActivityLike[]
    activityReplies ActivityReply[]

    // ENCRYPTION KEYS
    publicKey              String?
    encryptedPrivateKey    String?
    encryptionPasswordHash String?   @db.Text

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([username])
    @@index([email])
}

model Passkey {
    id         String   @id @default(uuid())
    publicKey  String // The base64url encoded public key
    counter    Int // Credential counter
    transports String[] // Transports (usb, nfc, ble, internal, hybrid)
    name       String? // label for the passkey
    createdAt  DateTime @default(now())
    userId     String
    user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
}

model ApiKey {
    id         String    @id @default(uuid())
    hash       String    @db.Text
    prefix     String
    name       String
    lastUsedAt DateTime?
    expiresAt  DateTime?
    createdAt  DateTime  @default(now())
    updatedAt  DateTime  @updatedAt
    userId     String
    user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([hash])
    @@index([userId])
}
