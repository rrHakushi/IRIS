// use prisma-8

enum MovieStatus {
    RELEASED
    IN_PRODUCTION
    POST_PRODUCTION
    RUMORED
    CANCELLED
    UNKNOWN
}

model Movie {
    id      Int     @id @default(autoincrement())
    tmdbId  Int?
    imdbId  String?
    tvDBId  Int?    @unique
    simklId Int?

    titlePrimary   String
    titleSecondary String?
    titleNative    String?

    coverImage  String?
    bannerImage String?
    images      Jsonb?

    description      String?
    originalLanguage String?
    countryOfOrigin  String?
    runtime          Int?
    budget           BigInt?
    revenue          BigInt?

    releaseDateYear  Int?
    releaseDateMonth Int?
    releaseDateDay   Int?

    genres MovieGenre[]
    tags MovieTag[]
    status   MovieStatus @default(RELEASED)
    isAdult  Boolean     @default(false)
    synonyms String[]
    trailers Jsonb?
    locked   Boolean     @default(false)

    averageScore       Float?
    favorites          Int    @default(0)
    popularity         Int    @default(0)
    totalScoreSum      Int?
    scoredCount        Int?
    statusDistribution Jsonb @default(json`{}`)
    scoreDistribution Jsonb @default(json`{}`)

    imdbRating Float?
    imdbVotes  Int?

    sources Jsonb?

    ageRating      String?
    ageRatingGuide String?

    imdbUpdatedAt Int?
    tvdbUpdatedAt Int?

    createdAt DateTime @default(now())
    updatedAt DateTime @onCreate(now()) @onUpdate(now())

    characters       MediaCharacter[]
    studios          MediaStudio[]
    staff            MediaStaff[]
    userLists        MovieList[]
    reviews          MovieReview[]
    customListEntries CustomListEntry[]

    @@index([titlePrimary])
    @@index([status])
    @@index([popularity])
    @@index([averageScore])
}
