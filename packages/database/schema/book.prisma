// use prisma-8

enum BookStatus {
    PUBLISHED
    RELEASING
    CANCELLED
    ON_HIATUS
    UNKNOWN
}

model Book {
    id            Int     @id @default(autoincrement())
    googleBookId  String? @unique
    isbn10        String?
    isbn13        String?
    openLibraryId String?

    titlePrimary   String
    titleSecondary String?
    subtitle       String?
    slug           String?
    tagline        String?

    coverImage  String?
    bannerImage String?
    images      Jsonb?

    description      String?
    originalLanguage String?
    countryOfOrigin  String?
    series           String?
    seriesPosition   Float?
    format           String?
    website          String?
    siteUrl          String?
    previewLink      String?
    infoLink         String?
    buyLink          String?

    releaseDateYear  Int?
    releaseDateMonth Int?
    releaseDateDay   Int?
    releaseDate      DateTime?

    pageCount    Int?
    chapterCount Int?
    volumeCount  Int?

    genres BookGenre[]
    subjects   String[]
    tags BookTag[]
    publishers String[]
    authors    String[]
    status     BookStatus @default(UNKNOWN)
    isAdult    Boolean    @default(false)
    synonyms   String[]
    locked     Boolean    @default(false)

    averageScore            Float?
    googleBooksRating       Float?
    googleBooksRatingsCount Int?

    favorites          Int  @default(0)
    popularity         Int  @default(0)
    totalScoreSum      Int?
    scoredCount        Int?
    statusDistribution Jsonb @default(json`{}`)
    scoreDistribution Jsonb @default(json`{}`)

    sources Jsonb?

    retailPrice         Float?
    retailPriceCurrency String?
    ageRating           String?
    ageRatingGuide      String?
    contentRatings      Jsonb?

    googleBooksUpdatedAt Int?

    createdAt DateTime @default(now())
    updatedAt DateTime @onCreate(now()) @onUpdate(now())

    characters       MediaCharacter[]
    studios          MediaStudio[]
    staff            MediaStaff[]
    userLists        BookList[]
    reviews          BookReview[]
    customListEntries CustomListEntry[]

    @@index([titlePrimary])
    @@index([status])
    @@index([popularity])
    @@index([averageScore])
}
