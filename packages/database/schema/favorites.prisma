// use prisma-8

enum FavoriteType {
    ANIME
    MANGA
    MOVIE
    TV
    GAME
    BOOK
    MUSIC_ALBUM
    MUSIC_TRACK
    CHARACTER
    PERSON
    STUDIO
    USER
    OTHER
}

model Favorite {
    id        String       @id @onCreate(uuid())
    userId    String
    user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
    type      FavoriteType
    targetId  Int
    createdAt DateTime     @default(now())

    @@unique([userId, type, targetId])
    @@index([userId])
    @@index([type, targetId])
}
