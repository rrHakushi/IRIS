// use prisma-8

model Other {
    id          Int     @id @default(autoincrement())
    creatorId   String
    creator     User    @relation("CreatedOtherItems", fields: [creatorId], references: [id], onDelete: Cascade)

    titlePrimary   String
    titleSecondary String?
    description    String?

    coverImage     String?
    bannerImage    String?
    format         String?

    startDate      DateTime?
    endDate        DateTime?

    isPublished    Boolean @default(false)

    // [{ key: string, label: string, unit?: string, max?: number }]
    progressFields Jsonb   @default(json`[]`)
    // The designated progress field key to increment in /increment route (max 1)
    incrementFieldKey String?

    // Stored pre-update snapshot for tracking users when published item is edited
    preUpdateSnapshot Jsonb?

    // Mandatory statistics fields
    averageScore       Float?
    favorites          Int    @default(0)
    popularity         Int    @default(0)
    totalScoreSum      Int?
    scoredCount        Int?
    statusDistribution Jsonb @default(json`{}`)
    scoreDistribution Jsonb @default(json`{}`)

    createdAt DateTime @default(now())
    updatedAt DateTime @onCreate(now()) @onUpdate(now())

    userLists         OtherList[]
    customListEntries CustomListEntry[]

    @@index([creatorId])
    @@index([titlePrimary])
    @@index([isPublished])
    @@index([popularity])
    @@index([averageScore])
}

model OtherList {
    id          Int       @id @default(autoincrement())
    userId      String
    user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    otherId     Int
    other       Other     @relation(fields: [otherId], references: [id], onDelete: Cascade)

    status      ListStatus @default(PLANNED)
    // Map of progress field keys to values: { [key: string]: number }
    progressValues Jsonb @default(json`{}`)

    score       Float?
    notes       String?
    private     Boolean   @default(false)

    startedAt   DateTime?
    completedAt DateTime?

    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @onCreate(now()) @onUpdate(now())

    @@unique([userId, otherId])
    @@index([userId])
    @@index([otherId])
    @@index([status])
    @@index([userId, status])
    @@index([userId, score])
}
