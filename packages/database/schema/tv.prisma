// use prisma-8

model Tv {
    id       Int     @id @default(autoincrement())
    tmdbId   Int?
    imdbId   String?
    tvDBId   Int?    @unique
    simklId  Int?
    tvmazeId Int?

    titlePrimary   String
    titleSecondary String?
    titleNative    String?

    coverImage  String?
    bannerImage String?
    images      Jsonb?

    description      String?
    originalLanguage String?
    countryOfOrigin  String?
    episodeCount     Int?
    seasonCount      Int?
    averageRuntime   Int?
    showType         String?

    broadcastTime String?
    broadcastDays String[]

    firstAiredYear  Int?
    firstAiredMonth Int?
    firstAiredDay   Int?

    lastAiredYear  Int?
    lastAiredMonth Int?
    lastAiredDay   Int?

    genres TvGenre[]
    tags TvTag[]
    networks String[]

    status   MediaStatus @default(UNKNOWN)
    isAdult  Boolean  @default(false)
    synonyms String[]
    trailers Jsonb?
    locked   Boolean  @default(false)

    averageScore        Float?
    imdbRating          Float?
    imdbVotes           Int?
    tvmazeRating        Float?
    rottenTomatoesScore Float?
    awards              String?

    favorites          Int  @default(0)
    popularity         Int  @default(0)
    totalScoreSum      Int?
    scoredCount        Int?
    statusDistribution Jsonb @default(json`{}`)
    scoreDistribution Jsonb @default(json`{}`)

    sources Jsonb?

    ageRating      String?
    ageRatingGuide String?
    contentRatings Jsonb?

    imdbUpdatedAt   Int?
    tvdbUpdatedAt   Int?
    tvmazeUpdatedAt Int?

    createdAt DateTime @default(now())
    updatedAt DateTime @onCreate(now()) @onUpdate(now())

    seasons          TvSeason[]
    episodes         TvEpisode[]
    characters       MediaCharacter[]
    studios          MediaStudio[]
    staff            MediaStaff[]
    userLists        TvList[]
    reviews          TvReview[]
    customListEntries CustomListEntry[]

    @@index([titlePrimary])
    @@index([status])
    @@index([popularity])
    @@index([averageScore])
}

model TvSeason {
    id           Int  @id @default(autoincrement())
    tvId         Int
    seasonNumber Int
    tvdbSeasonId Int?
    tmdbSeasonId Int?
    tv           Tv   @relation(fields: [tvId], references: [id], onDelete: Cascade)

    titlePrimary   String?
    titleSecondary String?
    description    String?
    posterImage    String?

    airDateYear  Int?
    airDateMonth Int?
    airDateDay   Int?
    episodeCount Int?

    trailers Jsonb?
    sources  Jsonb?

    createdAt DateTime @default(now())
    updatedAt DateTime @onCreate(now()) @onUpdate(now())

    episodes       TvEpisode[]
    seasonProgress TvSeasonProgress[]
    reviews        TvReview[]

    @@unique([tvId, seasonNumber])
    @@index([tvId])
}

model TvEpisode {
    id            Int       @id @default(autoincrement())
    tvId          Int
    seasonId      Int?
    seasonNumber  Int
    episodeNumber Int
    tv            Tv        @relation(fields: [tvId], references: [id], onDelete: Cascade)
    season        TvSeason? @relation(fields: [seasonId], references: [id], onDelete: Cascade)

    titlePrimary   String
    titleSecondary String?
    titleNative    String?

    description    String?
    duration       Int?
    airDate        DateTime?
    rating         Float?
    episodeType    String?
    thumbnail      String?
    isFiller       Boolean   @default(false)
    isRecap        Boolean   @default(false)
    streamingLinks Jsonb?

    opStart    Int?
    opEnd      Int?
    edStart    Int?
    edEnd      Int?
    recapStart Int?
    recapEnd   Int?

    skipTimestamps Jsonb?
    sources        Jsonb?

    createdAt DateTime @default(now())
    updatedAt DateTime @onCreate(now()) @onUpdate(now())

    watchedEpisodes TvWatchedEpisode[]

    @@unique([tvId, seasonNumber, episodeNumber])
    @@index([tvId])
    @@index([seasonId])
}
