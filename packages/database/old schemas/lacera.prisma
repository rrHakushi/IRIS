model LaceraFile {
    id         String   @id @default(nanoid())
    key        String   @unique
    userId     String
    isPublic   Boolean  @default(false)
    wrappedKey String
    createdAt  DateTime @default(now())

    isFolder        Boolean @default(false)
    name            String // Encrypted name (AES-GCM base64 format)
    size            Int? // Size of file (optional, folders have null)
    type            String? // Encrypted mime-type
    parentId        String? // Folder hierarchy parent
    isTrash         Boolean @default(false)
    isVault         Boolean @default(false)
    isUploadPending Boolean @default(false) // True while a multipart upload is still in progress
    chunkCount      Int? // Number of 32 MiB chunks; null = single-block (old upload format)

    user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
    parent   LaceraFile?   @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
    children LaceraFile[]  @relation("FolderHierarchy")
    shares   LaceraShare[] @relation("FileShares")

    @@index([userId])
    @@index([key])
    @@index([parentId])
}

model LaceraShare {
    id         String   @id @default(nanoid())
    fileId     String
    userId     String // Recipient user ID
    wrappedKey String // Symmetric key wrapped with recipient's public key
    allowEdit  Boolean  @default(true)
    createdAt  DateTime @default(now())

    file LaceraFile @relation("FileShares", fields: [fileId], references: [id], onDelete: Cascade)
    user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([fileId, userId])
    @@index([userId])
    @@index([fileId])
}

// Tracks in-progress S3 multipart uploads for resumability.
// Created on upload init; completedAt is set on success; expired rows are cleaned up by cron.
model LaceraUpload {
    id          String    @id @default(nanoid())
    fileId      String    @unique // Matching LaceraFile.id (the pending stub)
    uploadId    String // S3 CreateMultipartUpload UploadId
    key         String // S3 object key
    bucket      String
    chunkCount  Int
    completedAt DateTime? // Set when CompleteMultipartUpload succeeds
    expiresAt   DateTime // now() + 48 h; cron aborts expired rows
    createdAt   DateTime  @default(now())

    @@index([expiresAt])
    @@index([fileId])
}
