model AquilaMovieV2 {
    id      Int     @id @default(autoincrement())
    tvDBId  Int?    @unique
    imdbId  String? @unique
    tmdbId  Int?    @unique
    traktId Int?    @unique

    titlePrimary   String  @db.Text // Primary English title (or fallback to secondary/native)
    titleSecondary String? @db.Text
    titleNative    String? @db.Text
    tagline        String? @db.Text

    coverImage  String? @db.Text
    bannerImage String? @db.Text
    images      Json?   @db.JsonB // Multi-source galleries: { tvdb: { posters: [], backdrops: [], logos: [] }, fanart: { ... } }

    description      String? @db.Text
    originalLanguage String? // e.g. "en", "ja", "fr"
    countryOfOrigin  String? // e.g. "US", "JP"
    runtime          Int? // Duration in minutes
    budget           BigInt? // Production budget in USD
    revenue          BigInt? // Box office revenue in USD
    homepage         String? @db.Text
    siteUrl          String? @db.Text

    releaseDateYear  Int?
    releaseDateMonth Int?
    releaseDateDay   Int?

    genres   String[]    @db.Text
    status   MovieStatus @default(RELEASED)
    isAdult  Boolean     @default(false)
    synonyms String[]    @db.Text
    trailers Json?       @db.JsonB // Video trailers & teasers from YouTube/Vimeo
    locked   Boolean     @default(false)

    averageScore       Float?
    favorites          Int    @default(0)
    popularity         Int    @default(0)
    totalScoreSum      Int?   @db.Integer
    scoredCount        Int?   @db.Integer
    statusDistribution Json   @default("{}") @db.JsonB
    scoreDistribution  Json   @default("{}") @db.JsonB

    imdbRating Float?
    imdbVotes  Int?

    sources Json? @db.JsonB // Data origins: [{ provider: "THETVDB", externalId: "...", fieldsProvided: [...] }]

    ageRating      String? // Motion picture rating e.g. "PG-13", "R", "NC-17"
    ageRatingGuide String? // e.g. "Language, Violence, Nudity"

    imdbUpdatedAt Int?
    tvdbUpdatedAt Int?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    characters          AquilaMediaCharacterV2[]
    studios             AquilaMediaStudioV2[]
    staff               AquilaMediaStaffV2[]
    userLists           AquilaMovieUserListV2[]
    reviews             AquilaMovieReview[]
    recommendationsFrom AquilaMovieRecommendationV2[] @relation("MovieRecommendationSource")
    recommendationsTo   AquilaMovieRecommendationV2[] @relation("MovieRecommendationTarget")

    @@index([titlePrimary])
    @@index([status])
    @@index([popularity(sort: Desc)])
    @@index([averageScore(sort: Desc)])
}

model AquilaMovieUserListV2 {
    id          Int             @id @default(autoincrement())
    username    String
    movieId     Int
    status      MovieListStatus @default(PLANNING)
    score       Float?
    scoreFormat ScoreFormat     @default(POINT_10)
    notes       String?         @db.Text
    rewatched   Int             @default(0)
    private     Boolean         @default(false)
    customLists String[]        @db.Text // Custom list folder names

    startDate DateTime?
    endDate   DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    connections Json? @db.JsonB

    user  User          @relation(fields: [username], references: [username], onDelete: Cascade)
    movie AquilaMovieV2 @relation(fields: [movieId], references: [id], onDelete: Cascade)

    @@unique([username, movieId])
    @@index([username])
    @@index([movieId])
    @@index([status])
    @@index([username, status])
    @@index([username, score(sort: Desc)])
}

model AquilaMovieReview {
    id        Int     @id @default(autoincrement())
    username  String
    movieId   Int
    summary   String  @db.Text // Short review headline
    body      String  @db.Text // Full markdown review content
    score     Float // 1-10 or 1-100 rating
    upvotes   Int     @default(0)
    isSpoiler Boolean @default(false)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    user  User          @relation(fields: [username], references: [username], onDelete: Cascade)
    movie AquilaMovieV2 @relation(fields: [movieId], references: [id], onDelete: Cascade)

    @@unique([username, movieId])
    @@index([movieId])
    @@index([username])
    @@index([score(sort: Desc)])
}

model AquilaMovieRecommendationV2 {
    id             Int     @id @default(autoincrement())
    movieId        Int // Source Movie
    relatedMovieId Int // Recommended Movie
    rating         Int     @default(1) // Upvote / agreement score
    userNotes      String? @db.Text // "Why you should watch this if you liked X"

    movie        AquilaMovieV2 @relation("MovieRecommendationSource", fields: [movieId], references: [id], onDelete: Cascade)
    relatedMovie AquilaMovieV2 @relation("MovieRecommendationTarget", fields: [relatedMovieId], references: [id], onDelete: Cascade)

    @@unique([movieId, relatedMovieId])
    @@index([movieId])
    @@index([relatedMovieId])
}

enum MovieListStatus {
    PLANNING
    COMPLETED
    DROPPED
}

enum MovieStatus {
    RELEASED
    IN_PRODUCTION
    POST_PRODUCTION
    RUMORED
    CANCELLED
    UNKNOWN
}
