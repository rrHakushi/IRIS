{
  "name": "@IRIS/database",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "dotenvx run -f ../../.env -- tsc",
    "db:generate": "dotenvx run -f ../../.env -- prisma generate",
    "db:push": "dotenvx run -f ../../.env -- prisma db push",
    "db:studio": "dotenvx run -f ../../.env -- prisma studio",
    "db:all": "pnpm db:push && pnpm db:generate && pnpm build"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@prisma/client-runtime-utils": "^7.10.0",
    "dotenv": "^17.4.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "prisma": "^7.10.0",
    "typescript": "^7.0.2"
  }
}