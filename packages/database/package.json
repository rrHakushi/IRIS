{
  "name": "@Iris/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun run contract:emit && tsc && cp src/contract.d.ts src/contract.json dist/",
    "contract:emit": "bun -e \"process.exit(Bun.spawnSync(['infisical', 'run', '--env=' + (process.env.INFISICAL_ENV || 'dev'), '--', 'prisma', 'contract', 'emit'], { stdio: ['inherit', 'inherit', 'inherit'] }).exitCode ?? 1)\"",
    "db:update": "bun -e \"process.exit(Bun.spawnSync(['infisical', 'run', '--env=' + (process.env.INFISICAL_ENV || 'dev'), '--', 'prisma', 'db', 'update'], { stdio: ['inherit', 'inherit', 'inherit'] }).exitCode ?? 1)\"",
    "db:verify": "bun -e \"process.exit(Bun.spawnSync(['infisical', 'run', '--env=' + (process.env.INFISICAL_ENV || 'dev'), '--', 'prisma', 'db', 'verify'], { stdio: ['inherit', 'inherit', 'inherit'] }).exitCode ?? 1)\"",
    "db:migrate": "bun -e \"process.exit(Bun.spawnSync(['infisical', 'run', '--env=' + (process.env.INFISICAL_ENV || 'dev'), '--', 'prisma', 'db', 'migrate'], { stdio: ['inherit', 'inherit', 'inherit'] }).exitCode ?? 1)\"",
    "db:prepare-prisma8": "bun -e \"process.exit(Bun.spawnSync(['infisical', 'run', '--env=' + (process.env.INFISICAL_ENV || 'dev'), '--', 'bun', 'run', 'scripts/prepare-prisma8.ts'], { stdio: ['inherit', 'inherit', 'inherit'] }).exitCode ?? 1)\"",
    "db:unify-status": "bun -e \"process.exit(Bun.spawnSync(['infisical', 'run', '--env=' + (process.env.INFISICAL_ENV || 'dev'), '--', 'bun', 'run', 'scripts/unify-status.ts'], { stdio: ['inherit', 'inherit', 'inherit'] }).exitCode ?? 1)\""
  },
  "dependencies": {
    "@prisma/orm-postgres": "8.0.0-rc.21"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "prisma": "8.0.0-rc.28",
    "typescript": "^7.0.2"
  }
}