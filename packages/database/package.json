{
  "name": "@Iris/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun run contract:emit && tsc && cp src/contract.d.ts dist/contract.d.ts",
    "contract:emit": "bun --bun --env-file=../../.env  prisma contract emit",
    "db:update": "bun --bun --env-file=../../.env prisma db update",
    "db:verify": "bun --bun --env-file=../../.env prisma db verify",
    "db:migrate": "bun --bun --env-file=../../.env prisma db migrate",
    "db:prepare-prisma8": "bun --bun --env-file=../../.env run scripts/prepare-prisma8.ts",
    "db:unify-status": "bun --bun --env-file=../../.env run scripts/unify-status.ts"
  },
  "dependencies": {
    "@prisma/orm-postgres": "^8.0.0-rc.21"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "prisma": "8.0.0-rc.28",
    "typescript": "^7.0.2"
  }
}