{
  "name": "@IRIS/database",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "db:generate": "bun --bun prisma generate",
    "db:push": "bun --bun prisma db push",
    "db:studio": "bun --bun prisma studio",
    "db:all": "bun run db:push && bun run db:generate && bun run build"
  },
  "dependencies": {
    "@prisma/adapter-pg": "~7.10.0",
    "@prisma/client": "~7.10.0",
    "@prisma/client-runtime-utils": "~7.10.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "prisma": "~7.10.0",
    "typescript": "^7.0.2"
  }
}