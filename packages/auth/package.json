{
  "name": "@IRIS/auth",
  "version": "1.0.0",
  "private": true,
  "description": "Unified authentication package for IRIS powered by NextAuth",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./verify": {
      "types": "./dist/verify.d.ts",
      "import": "./dist/verify.js",
      "require": "./dist/verify.js",
      "default": "./dist/verify.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@IRIS/api": "workspace:*",
    "next-auth": "^4.24.15"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@workspace/typescript-config": "workspace:*",
    "typescript": "^7.0.2"
  },
  "license": "ISC"
}
