{
  "name": "@IRIS/shared",
  "version": "1.0.0",
  "private": true,
  "description": "Shared constants and utility functions for the IRIS ecosystem",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./constants": {
      "types": "./dist/constants/index.d.ts",
      "import": "./dist/constants/index.js",
      "default": "./dist/constants/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@workspace/typescript-config": "workspace:*",
    "typescript": "^7.0.2"
  },
  "license": "ISC"
}
