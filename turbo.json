{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream-with-experimental-timestamps",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "@IRIS/elysia#build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": []
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "format": {
      "dependsOn": [
        "^format"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "contract:emit": {
      "cache": false
    },
    "db:update": {
      "cache": false
    },
    "db:verify": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "sdk": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "swagger": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "nestia": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    }
  }
}