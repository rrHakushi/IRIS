{
  "name": "IRIS2",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=\"./packages/*\"",
    "dev": "dotenvx run -- turbo run dev",
    "lint": "turbo run lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "db:push": "turbo run db:push --filter=@IRIS/database",
    "db:studio": "turbo run db:studio --filter=@IRIS/database",
    "db:generate": "turbo run db:generate --filter=@IRIS/database",
    "db:all": "turbo run db:all --filter=@IRIS/database",
    "elysia:dev": "dotenvx run -- turbo run dev --filter=@IRIS/elysia",
    "elysia:build": "turbo run build --filter=@IRIS/elysia",
    "plugin:borealis:build": "python3 plugins/JellyBorealis/package.py",
    "plugin:borealis:release": "python3 plugins/JellyBorealis/package.py --ci"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^2.34.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "pnpm": {
    "overrides": {
      "prisma": "^7",
      "@prisma/client": "^7",
      "@prisma/adapter-pg": "^7",
      "@prisma/client-runtime-utils": "^7"
    },
    "updateConfig": {
      "ignoreDependencies": [
        "prisma",
        "@prisma/*"
      ]
    }
  }
}