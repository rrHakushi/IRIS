{
  "name": "IRIS2",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=\"./packages/*\"",
    "dev": "infisical run --env=dev -- turbo run dev",
    "db:contract:emit": "infisical run --env=dev -- turbo run contract:emit --filter=@NamelessLiberty/db",
    "db:update": "infisical run --env=dev -- turbo run db:update --filter=@NamelessLiberty/db",
    "db:verify": "infisical run --env=dev -- turbo run db:verify --filter=@NamelessLiberty/db",
    "elysia:dev": "infisical run --env=dev -- turbo run dev --filter=@NamelessLiberty/elysia",
    "elysia:build": "infisical run --env=dev -- turbo run build --filter=@NamelessLiberty/elysia",
    "auth:migrate-passwords": "infisical run --env=dev -- bun scripts/migrate-passwords.ts",
    "vault:migrate-keys": "infisical run --env=dev -- bun scripts/migrate-vault-keys.ts",
    "db:update-description-urls": "infisical run --env=dev -- bun scripts/update-description-urls.ts",
    "plugin:borealis:build": "python3 plugins/JellyBorealis/package.py",
    "plugin:borealis:release": "python3 plugins/JellyBorealis/package.py --ci"
  },
  "devDependencies": {
    "@NamelessLiberty/db": "workspace:*",
    "@types/bun": "^1.4.4",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.4.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "trustedDependencies": [
    "@parcel/watcher",
    "@prisma/engines",
    "@swc/core",
    "esbuild",
    "msgpackr-extract",
    "prisma",
    "unrs-resolver"
  ]
}