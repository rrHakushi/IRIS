{
  "name": "IRIS2",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=\"./packages/*\"",
    "dev": "dotenvx run -- turbo run dev",
    "lint": "turbo run lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "db:push": "turbo run db:push --filter=@IRIS/database",
    "db:studio": "turbo run db:studio --filter=@IRIS/database",
    "db:generate": "turbo run db:generate --filter=@IRIS/database",
    "db:all": "turbo run db:all --filter=@IRIS/database",
    "elysia:dev": "dotenvx run -- turbo run dev --filter=@IRIS/elysia",
    "elysia:build": "turbo run build --filter=@IRIS/elysia",
    "route:create": "bun run --cwd apps/elysia scripts/create-route.ts",
    "route:delete": "bun run --cwd apps/elysia scripts/delete-route.ts",
    "route:sync": "bun run --cwd apps/elysia scripts/generate-manifests.ts",
    "sdk": "echo \"nestia sdk disabled\"",
    "swagger": "echo \"nestia swagger disabled\"",
    "nestia": "echo \"nestia disabled\""
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.10.11",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^2.21.0"
  }
}