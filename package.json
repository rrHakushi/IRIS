{
  "name": "IRIS2",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=\"./packages/*\"",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "db:push": "turbo run db:push --filter=@IRIS/database",
    "db:studio": "turbo run db:studio --filter=@IRIS/database",
    "db:generate": "turbo run db:generate --filter=@IRIS/database",
    "db:all": "turbo run db:all --filter=@IRIS/database",
    "elysia:dev": "turbo run dev --filter=@IRIS/elysia",
    "elysia:build": "turbo run build --filter=@IRIS/elysia",
    "auth:migrate-passwords": "bun scripts/migrate-passwords.ts",
    "plugin:borealis:build": "python3 plugins/JellyBorealis/package.py",
    "plugin:borealis:release": "python3 plugins/JellyBorealis/package.py --ci"
  },
  "devDependencies": {
    "@IRIS/database": "workspace:*",
    "@types/bun": "^1.4.3",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.4.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "trustedDependencies": [
    "@parcel/watcher",
    "@prisma/engines",
    "@swc/core",
    "esbuild",
    "msgpackr-extract",
    "prisma",
    "unrs-resolver"
  ],
  "overrides": {
    "prisma": "^7",
    "@prisma/client": "^7",
    "@prisma/adapter-pg": "^7",
    "@prisma/client-runtime-utils": "^7"
  }
}