{
  "name": "@IRIS/server",
  "version": "0.0.1",
  "description": "",
  "author": "rrHakushi",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "build": "dotenvx run -f ../../.env -- ttsc",
    "start": "dotenvx run -f ../../.env -- node dist/src/main.js",
    "dev": "dotenvx run -f ../../.env -- ttsc && dotenvx run -f ../../.env -- concurrently \"ttsc --watch\" \"node --watch-path=dist/src dist/src/main.js\"",
    "start:script": "dotenvx run -f ../../.env -- ttsx src/main.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "sdk": "dotenvx run -f ../../.env -- nestia sdk",
    "swagger": "dotenvx run -f ../../.env -- nestia swagger",
    "e2e:generate": "dotenvx run -f ../../.env -- nestia e2e",
    "nestia": "dotenvx run -f ../../.env -- nestia all"
  },
  "dependencies": {
    "@IRIS/auth": "workspace:*",
    "@IRIS/cache": "workspace:*",
    "@IRIS/database": "workspace:*",
    "@IRIS/permissions": "workspace:*",
    "@nestia/core": "^13.0.1",
    "@nestia/fetcher": "^13.0.1",
    "@nestia/sdk": "^13.0.1",
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-express": "^11.2.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@simplewebauthn/server": "^13.3.2",
    "concurrently": "^10.0.5",
    "dotenv": "^17.4.2",
    "otplib": "^13.5.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typia": "^14.0.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.11.0",
    "jest": "^30.4.2",
    "nestia": "^13.0.1",
    "prettier": "^3.9.6",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.12",
    "ttsc": "^0.28.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.67.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}