{
  "name": "web",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "dotenvx run -f ../../.env -- next dev",
    "build": "dotenvx run -f ../../.env -- next build",
    "start": "dotenvx run -f ../../.env -- next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "i18n:check": "bun scripts/manage-i18n.ts",
    "i18n:sync": "bun scripts/manage-i18n.ts --sync",
    "i18n:prune": "bun scripts/manage-i18n.ts --prune"
  },
  "dependencies": {
    "@IRIS/auth": "workspace:*",
    "@IRIS/database": "workspace:*",
    "@IRIS/elysia": "workspace:*",
    "@IRIS/permissions": "workspace:*",
    "@IRIS/shared": "workspace:*",
    "@elysiajs/eden": "^1.4.9",
    "@simplewebauthn/browser": "^13.1.0",
    "@tabler/icons-react": "^3.46.0",
    "@workspace/ui": "workspace:*",
    "next": "16.3.2",
    "next-auth": "^4.24.15",
    "next-intl": "^4.13.7",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^10.9.0",
    "typescript": "^7.0.2"
  }
}