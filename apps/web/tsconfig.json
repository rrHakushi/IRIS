{
  "extends": "@workspace/typescript-config/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/components/*": ["./components/*"],
      "@/config/*": ["./config/*"],
      "@/context/*": ["./context/*"],
      "@/hooks/*": ["./hooks/*"],
      "@/lib/*": ["./lib/*"],
      "@/locales/*": ["./locales/*"],
      "@/types/*": ["./types/*"],
      "@/app/*": ["./app/*"],
      "@/router": ["../elysia/src/router/index.ts"],
      "@/router/*": ["../elysia/src/router/*"],
      "@/utils/*": ["../elysia/src/utils/*"],
      "@/modules/*": ["../elysia/src/modules/*"],
      "@/services/*": ["../elysia/src/services/*"],
      "@/plugins/*": ["../elysia/src/plugins/*"],
      "@/*": ["./*"],
      "@IRIS/connections": ["../../packages/connections/src/index.ts"],
      "@IRIS/connections/*": ["../../packages/connections/src/*"],
      "@workspace/ui/postcss.config": ["../../packages/ui/postcss.config.mjs"],
      "@workspace/ui/globals.css": ["../../packages/ui/src/styles/globals.css"],
      "@workspace/ui/*": ["../../packages/ui/src/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
