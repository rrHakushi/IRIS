{
  "name": "@IRIS/elysia",
  "version": "0.0.1",
  "description": "",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "codegen": "bun --env-file=../../.env src/plugins/controllers.ts",
    "build:binary": "bun --env-file=../../.env src/plugins/controllers.ts && bun --env-file=../../.env build --compile --minify-whitespace --minify-syntax --target bun-linux-x64 --outfile server src/index.ts",
    "start": "./server",
    "test": "bun test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@IRIS/cache": "workspace:*",
    "@IRIS/connections": "workspace:*",
    "@IRIS/database": "workspace:*",
    "@IRIS/permissions": "workspace:*",
    "@IRIS/shared": "workspace:*",
    "@Iris/logger": "workspace:*",
    "@aws-sdk/client-s3": "^3.1154.0",
    "@elysia/bearer": "2.0.0-beta.1",
    "@elysia/cors": "2.0.0-rc.0",
    "@elysia/jwt": "2.0.0-beta.1",
    "@elysia/openapi": "^2.0.0-rc.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.1",
    "@simplewebauthn/server": "^14.0.3",
    "@types/qrcode": "^1.5.6",
    "bullmq": "^6.4.0",
    "elysia": "^2.0.0-rc.0",
    "exact-mirror": "^1.2.6",
    "ioredis": "^6.0.0",
    "jose": "^6.2.13",
    "nodemailer": "^10.1.7",
    "otplib": "^13.5.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typebox": "^1.4.2"
  },
  "devDependencies": {
    "@elysia/eden": "2.0.0-beta.6",
    "@types/bun": "^1.4.3",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}