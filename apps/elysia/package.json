{
  "name": "@IRIS/elysia",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./router": {
      "types": "./src/router/index.ts",
      "import": "./src/router/index.ts",
      "default": "./src/router/index.ts"
    }
  },
  "scripts": {
    "dev": "dotenvx run -f ../../.env -- bun --no-warnings --watch src/index.ts",
    "start": "dotenvx run -f ../../.env -- bun --no-warnings run src/index.ts",
    "build": "echo \"@IRIS/elysia build completed\"",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,js,json}\"",
    "route:create": "bun run scripts/create-route.ts"
  },
  "dependencies": {
    "@IRIS/cache": "workspace:*",
    "@IRIS/database": "workspace:*",
    "@IRIS/permissions": "workspace:*",
    "@IRIS/shared": "workspace:*",
    "@aws-sdk/client-s3": "^3.1121.0",
    "@elysiajs/bearer": "^1.4.4",
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@noble/post-quantum": "^0.7.1",
    "@react-email/components": "^0.0.33",
    "@react-email/render": "^1.0.5",
    "@simplewebauthn/server": "^13.3.2",
    "elysia": "2.0.0-beta.6",
    "next-auth": "^4.24.15",
    "nodemailer": "^6.10.0",
    "otplib": "^13.5.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.21.0",
    "@types/bun": "latest",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^6.4.17",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^10.9.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  }
}
