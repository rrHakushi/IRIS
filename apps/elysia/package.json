{
  "name": "@IRIS/elysia",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./router": {
      "types": "./src/router/index.ts",
      "import": "./src/router/index.ts",
      "default": "./src/router/index.ts"
    }
  },
  "scripts": {
    "dev": "dotenvx run -f ../../.env -- bun --no-warnings --watch src/index.ts",
    "start": "dotenvx run -f ../../.env -- bun --no-warnings run src/index.ts",
    "build": "echo \"@IRIS/elysia build completed\"",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,js,json}\""
  },
  "dependencies": {
    "@IRIS/cache": "workspace:*",
    "@IRIS/database": "workspace:*",
    "@IRIS/permissions": "workspace:*",
    "@elysiajs/bearer": "^1.4.4",
    "@simplewebauthn/server": "^13.3.2",
    "elysia": "2.0.0-beta.6",
    "next-auth": "^4.24.15",
    "otplib": "^13.5.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.21.0",
    "@types/bun": "latest",
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.6",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^10.9.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  }
}
