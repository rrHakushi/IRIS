{
  "name": "@IRIS/elysia",
  "version": "0.0.1",
  "description": "",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "infisical run --env=dev -- bun --watch src/index.ts",
    "build": "bun run codegen",
    "typecheck": "tsc --noEmit",
    "codegen": "bun -e \"process.exit(Bun.spawnSync(['infisical', 'run', '--env=' + (process.env.INFISICAL_ENV || 'dev'), '--', 'bun', 'src/plugins/controllers.ts'], { stdio: ['inherit', 'inherit', 'inherit'] }).exitCode ?? 1)\"",
    "build:binary": "bun run codegen && bun -e \"process.exit(Bun.spawnSync(['infisical', 'run', '--env=' + (process.env.INFISICAL_ENV || 'dev'), '--', 'bun', 'build', '--compile', '--minify-whitespace', '--minify-syntax', '--target', 'bun-linux-x64', '--outfile', 'server', 'src/index.ts'], { stdio: ['inherit', 'inherit', 'inherit'] }).exitCode ?? 1)\"",
    "start": "./server",
    "test": "bun test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@IRIS/cache": "workspace:*",
    "@IRIS/connections": "workspace:*",
    "@Iris/db": "workspace:*",
    "@IRIS/permissions": "workspace:*",
    "@IRIS/shared": "workspace:*",
    "@Iris/logger": "workspace:*",
    "@aws-sdk/client-s3": "^3.1165.0",
    "@elysia/bearer": "2.0.0-beta.1",
    "@elysia/cors": "2.0.0-rc.0",
    "@elysia/jwt": "2.0.0-beta.1",
    "@elysia/openapi": "^2.0.0-rc.1",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.3.0",
    "@simplewebauthn/server": "^14.1.0",
    "@types/qrcode": "^1.5.6",
    "bullmq": "^6.7.3",
    "elysia": "^2.0.0-rc.4",
    "exact-mirror": "^1.2.7",
    "ioredis": "^6.0.0",
    "jose": "^6.2.17",
    "nodemailer": "^10.5.0",
    "otplib": "^13.6.0",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typebox": "^1.4.6"
  },
  "devDependencies": {
    "@elysia/eden": "2.0.0-beta.6",
    "@types/bun": "^1.4.4",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}