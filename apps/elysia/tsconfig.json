{
  "extends": "@workspace/typescript-config/base.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [
      "bun",
      "node"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@IRIS/connections": [
        "../../packages/connections/src/index.ts"
      ],
      "@IRIS/connections/*": [
        "../../packages/connections/src/*"
      ]
    },
    "declaration": false,
    "declarationMap": false,
    "noImplicitAny": false,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": [
    "src/**/*",
    "types.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}